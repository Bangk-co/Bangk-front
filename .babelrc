{
  "presets": ["next/babel"],
  "plugins": [
    ["import", { "libraryName": "antd", "style": true }],
    [
      "babel-plugin-styled-components",
      {
        "ssr": true,
        "minify": false,
        "transpileTemplateLiterals": false,
        "pure": true,
        "namespace": "my-app"
      }
    ]
  ]
}
